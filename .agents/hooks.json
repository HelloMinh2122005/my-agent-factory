{
  "rubric-protection": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/protect-rubric.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
